---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import SunBurst from "../components/decor/SunBurst.astro";
import { t } from "../data/content.ts";
---
<BaseLayout title="Pagina niet gevonden | Haagse Brandmerk" description="De pagina die je zoekt bestaat niet of is verplaatst.">
  <section class="min-h-[80vh] flex items-center justify-center relative overflow-hidden retro-grain" style="background: hsl(var(--retro-cream))">
    <SunBurst class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] opacity-15 retro-spin pointer-events-none" color="hsl(var(--retro-mustard))" />
    <div class="container mx-auto px-6 text-center relative z-10">
      <p class="retro-display text-[120px] md:text-[180px] leading-none" style="color: hsl(var(--retro-rust))">{t.notFound.title}</p>
      <h1 class="font-display text-2xl md:text-3xl font-bold mb-3" style="color: hsl(var(--retro-ink))">{t.notFound.message}</h1>
      <p class="text-base mb-8" style="color: hsl(var(--retro-ink) / 0.7)">{t.notFound.description}</p>
      <a href="/" class="retro-pill-btn">
        <span class="relative z-10 inline-flex items-center gap-2"><Icon name="arrow-left" size={16} /> {t.notFound.backHome}</span>
      </a>
    </div>
  </section>
</BaseLayout>
