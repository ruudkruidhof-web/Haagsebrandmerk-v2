---
import V2Layout from "../../layouts/V2Layout.astro";
import ScrollReveal from "../../components/ScrollReveal.astro";
import BrowserFrame from "../../components/BrowserFrame.astro";
import Icon from "../../components/Icon.astro";
import { t, contentProjects, PHONE_NUMBER, PHONE_DISPLAY } from "../../data/content.ts";

const CONCEPT_IDS = new Set(["de-verse-gier", "den-hollander-schilderwerken", "wild-en-wortel", "mondzorg-de-pijp"]);
const counts = {
  alle: contentProjects.length,
  redesign: contentProjects.filter((p) => p.type === "redesign").length,
  nieuw: contentProjects.filter((p) => p.type === "nieuw").length,
};
const filters = [
  { label: t.portfolio.filterAll, value: "alle", count: counts.alle },
  { label: t.portfolio.filterRedesigns, value: "redesign", count: counts.redesign },
  { label: t.portfolio.filterNew, value: "nieuw", count: counts.nieuw },
];
---
<V2Layout
  title="Portfolio - Projecten waar ik trots op ben | Haagse Brandmerk"
  description="Bekijk mijn recente projecten. Van trouwambtenaar tot festival, van techbedrijf tot vakantieappartement. Elk project met een eigen verhaal."
>
  <section class="pt-32 pb-24 relative overflow-hidden retro-grain" style="background: hsl(var(--retro-cream))">
    <div class="absolute -left-24 top-24 w-[360px] h-[360px] retro-blob-radius pointer-events-none" style="background: hsl(var(--retro-butter) / 0.85)"></div>
    <div class="absolute top-24 -right-20 w-[340px] h-[340px] retro-blob-radius-2 retro-blob-idle-2 pointer-events-none" style="background: hsl(var(--retro-terracotta) / 0.45)"></div>

    <div class="container mx-auto px-6 relative z-10">
      <ScrollReveal class="block">
        <span class="retro-sticker mb-5">{t.portfolio.tag}</span>
        <h1 class="retro-display text-5xl md:text-7xl lg:text-8xl mt-2 mb-5">{t.portfolio.title}</h1>
        <p class="text-lg max-w-xl mb-10" style="color: hsl(var(--retro-ink) / 0.72)">{t.portfolio.subtitle}</p>
      </ScrollReveal>

      <div class="flex flex-wrap gap-2 mb-12" id="portfolio-filters">
        {filters.map((f, i) => (
          <button
            data-filter={f.value}
            class:list={["filter-btn px-4 py-2 rounded-full text-sm font-medium transition-colors border", i === 0 ? "is-active" : "text-muted-foreground"]}
          >
            {f.label}
            <span class="filter-count ml-1.5 text-xs opacity-60">({f.count})</span>
          </button>
        ))}
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" id="portfolio-grid">
        {contentProjects.map((project) => (
          <article class="project-item" data-type={project.type}>
            <a href={`/portfolio/${project.id}`} class="group block transition-all duration-300 tilt-card">
              <BrowserFrame url={project.liveUrl.replace("https://", "")}>
                <div class="relative overflow-hidden">
                  <img src={project.image} alt={project.title} loading="lazy" class="w-full h-auto transition-transform duration-700 group-hover:scale-105" />
                  <div class="absolute inset-0 bg-foreground/0 group-hover:bg-foreground/40 transition-all duration-500 flex items-center justify-center z-10">
                    <span class="text-background font-medium text-xs opacity-0 group-hover:opacity-100 transition-all duration-300 translate-y-2 group-hover:translate-y-0 flex items-center gap-1">
                      {t.portfolio.viewProject} <Icon name="arrow-up-right" size={12} />
                    </span>
                  </div>
                  {CONCEPT_IDS.has(project.id) ? (
                    <span class="absolute top-3 left-3 px-2.5 py-0.5 rounded-full text-[10px] font-semibold z-10" style="background: hsl(var(--retro-mustard)); color: hsl(var(--retro-ink)); border: 1.5px solid hsl(var(--retro-ink))">Concept</span>
                  ) : project.type === "redesign" ? (
                    <span class="absolute top-3 left-3 px-2.5 py-0.5 rounded-full bg-primary text-primary-foreground text-[10px] font-medium z-10">{t.typeBadgeRedesign}</span>
                  ) : (
                    <span class="absolute top-3 left-3 px-2.5 py-0.5 rounded-full bg-accent text-accent-foreground text-[10px] font-medium z-10">{t.typeBadgeNew}</span>
                  )}
                </div>
              </BrowserFrame>
              <div class="p-4 pt-3 border border-t-0 rounded-b-xl" style="background: hsl(var(--retro-cream)); border-color: hsl(var(--retro-ink))">
                <h2 class="font-display font-semibold text-sm group-hover:text-primary transition-colors">{project.title}</h2>
                <p class="text-muted-foreground text-xs mt-1 leading-relaxed line-clamp-2">{project.description}</p>
                <div class="flex gap-1.5 mt-2.5 flex-wrap">
                  {project.tags.map((tag) => (
                    <span class="text-[10px] px-2 py-0.5 rounded-full bg-muted text-muted-foreground border border-border">{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section data-section-dark="true" class="py-24 relative overflow-hidden border-y" style="background: hsl(var(--retro-ink)); color: hsl(var(--retro-cream)); border-color: hsl(var(--retro-ink))">
    <div class="container mx-auto px-6 text-center relative z-10">
      <ScrollReveal class="block">
        <p class="italic mb-6" style="color: hsl(var(--retro-cream) / 0.5)">{t.portfolio.bottomCatchPhrase}</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold mb-4">{t.projectDetail.ctaTitle}</h2>
        <p class="max-w-lg mx-auto text-lg mb-8" style="color: hsl(var(--retro-cream) / 0.6)">{t.projectDetail.ctaSubtitle}</p>
        <button data-contact-open class="fill-hover inline-flex h-12 px-8 items-center rounded-full font-medium transition-all gap-2"
          style="background: hsl(var(--retro-cream)); color: hsl(var(--retro-ink)); --fill-color: hsl(var(--retro-mustard))">
          <span class="relative z-10 inline-flex items-center gap-2">{t.projectDetail.ctaButton}<Icon name="arrow-right" size={16} /></span>
        </button>
        <a href={`tel:${PHONE_NUMBER}`} class="flex items-center justify-center gap-1.5 text-sm transition-colors mt-4" style="color: hsl(var(--retro-cream) / 0.5)">
          <Icon name="phone" size={14} /> {t.projectDetail.ctaCallDirect} {PHONE_DISPLAY}
        </a>
      </ScrollReveal>
    </div>
  </section>
</V2Layout>

<style>
  .filter-btn { border-color: hsl(var(--retro-ink) / 0.25); }
  .filter-btn.is-active { background: hsl(var(--retro-ink)); color: hsl(var(--retro-cream)); border-color: transparent; }
  .filter-btn.is-active .filter-count { opacity: 0.7; }
  .project-item.is-hidden { display: none; }
  .tilt-card { transition: transform 0.3s ease; }
  @media (hover: hover) {
    .tilt-card:hover { transform: translateY(-4px); }
  }
</style>

<script>
  function initPortfolioFilter() {
    const container = document.getElementById("portfolio-filters");
    if (!container) return;
    const buttons = container.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const items = document.querySelectorAll<HTMLElement>(".project-item");
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const f = btn.dataset.filter;
        buttons.forEach((b) => b.classList.toggle("is-active", b === btn));
        buttons.forEach((b) => b.classList.toggle("text-muted-foreground", b !== btn));
        items.forEach((item) => {
          const show = f === "alle" || item.dataset.type === f;
          item.classList.toggle("is-hidden", !show);
        });
      });
    });
  }
  initPortfolioFilter();
  document.addEventListener("astro:after-swap", initPortfolioFilter);
</script>
