---
import ScrollReveal from "./ScrollReveal.astro";
import AnimatedCounter from "./AnimatedCounter.astro";

const logos = [
  { name: "Reuring op de Delle", src: "/images/logos/reuring.png", path: "/portfolio/reuring-op-de-delle" },
  { name: "De Verse Gier", src: "/images/logos/de-verse-gier.png", path: "/portfolio/de-verse-gier" },
  { name: "Once Upon a Room", src: "/images/logos/once-upon-a-room.png", path: "/portfolio/once-upon-a-room" },
  { name: "Wild & Wortel", src: "/images/logos/wild-en-wortel.png", path: "/portfolio/wild-en-wortel" },
  { name: "Maisonette 1897", src: "/images/logos/maisonette-1897.png", path: "/portfolio/maisonette-1897" },
  { name: "Den Hollander Schilderwerken", src: "/images/logos/den-hollander.png", path: "/portfolio/den-hollander-schilderwerken" },
  { name: "Angela Ceremonies", src: "/images/logos/angela-ceremonies.png", path: "/portfolio/angela-ceremonies" },
  { name: "Enjoy The Breeze", src: "/images/logos/enjoy-the-breeze.png", path: "/portfolio/enjoy-the-breeze" },
];
---
<section class="py-14 md:py-20 border-y border-border/40 bg-section-warm">
  <div class="container mx-auto px-6">
    <ScrollReveal>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 md:gap-14 lg:gap-16 items-center">
        <div class="lg:col-span-4 text-center lg:text-left">
          <h2 class="font-display text-2xl md:text-3xl lg:text-4xl font-bold leading-tight mb-4">
            Vertrouwd door ZZP'ers & MKB'ers
          </h2>
          <p class="text-sm md:text-base text-muted-foreground leading-relaxed mb-7 mx-auto lg:mx-0 max-w-md">
            Van horeca en bouw tot praktijken en dienstverleners. Ondernemers die een site willen die hun vak net zo serieus neemt als zijzelf.
          </p>
          <div class="flex items-center justify-center lg:justify-start gap-6 md:gap-10">
            <div>
              <AnimatedCounter value={20} suffix="+" class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary block" />
              <p class="text-xs md:text-sm text-muted-foreground mt-1">Websites opgeleverd</p>
            </div>
            <div class="w-px h-12 md:h-14 bg-border"></div>
            <div>
              <AnimatedCounter value={100} suffix="+" class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-primary block" />
              <p class="text-xs md:text-sm text-muted-foreground mt-1">Pagina's gebouwd</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-8">
          <div class="grid grid-cols-4 gap-x-3 gap-y-6 sm:gap-x-6 sm:gap-y-8 md:gap-x-8 md:gap-y-10">
            {logos.map((logo) => (
              <a href={logo.path} aria-label={logo.name} class="flex items-center justify-center group">
                <img src={logo.src} alt={logo.name} loading="lazy" class="max-h-12 md:max-h-14 w-auto object-contain transition-transform duration-300 group-hover:-translate-y-1" />
              </a>
            ))}
          </div>
        </div>
      </div>
    </ScrollReveal>
  </div>
</section>
