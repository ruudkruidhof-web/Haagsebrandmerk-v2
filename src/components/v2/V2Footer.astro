---
import Icon from "../Icon.astro";
import { t, PHONE_NUMBER, PHONE_DISPLAY, EMAIL, LINKEDIN_URL } from "../../data/content.ts";

const footerLinks = [
  { label: "home", path: "/v2" },
  { label: "snel & helder", path: "/v2/snel" },
  { label: "maatwerk & merk", path: "/v2/maatwerk" },
  { label: "groei & resultaat", path: "/v2/groei" },
  { label: "prijzen", path: "/v2/prijzen" },
  { label: "portfolio", path: "/v2/portfolio" },
  { label: "over", path: "/v2/over" },
  { label: "contact", path: "/v2/contact" },
];
const year = new Date().getFullYear();
---
<footer class="border-t relative retro-grain" style="background: hsl(var(--retro-ink)); color: hsl(var(--retro-cream) / 0.68); border-color: hsl(var(--retro-cream) / 0.18)">
  <div class="container mx-auto px-6 py-16 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <div>
        <a href="/v2" class="font-display text-xl font-bold tracking-tight" style="color: hsl(var(--retro-cream))">
          haagse<span style="color: hsl(var(--retro-mustard))">brandmerk</span>
        </a>
        <p class="mt-4 max-w-sm leading-relaxed" style="color: hsl(var(--retro-cream) / 0.68)">{t.footer.description}</p>
        <div class="flex flex-col gap-2 mt-6 text-sm" style="color: hsl(var(--retro-cream) / 0.68)">
          <span class="flex items-center gap-1.5"><Icon name="mail" size={14} /> {EMAIL}</span>
          <span class="flex items-center gap-1.5"><Icon name="map-pin" size={14} /> Den Haag, Nederland</span>
          <a href={`tel:${PHONE_NUMBER}`} class="flex items-center gap-1.5 transition-colors hover:underline" style="color: hsl(var(--retro-cream) / 0.68)"><Icon name="phone" size={14} /> {PHONE_DISPLAY}</a>
        </div>
      </div>

      <div>
        <h4 class="font-display font-semibold mb-4 text-sm uppercase tracking-wider" style="color: hsl(var(--retro-cream))">Navigatie</h4>
        <ul class="space-y-3">
          {footerLinks.map((item) => (
            <li><a href={item.path} class="text-sm transition-colors inline-block hover:underline capitalize" style="color: hsl(var(--retro-cream) / 0.68)">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-display font-semibold mb-4 text-sm uppercase tracking-wider" style="color: hsl(var(--retro-cream))">{t.footer.socialsTitle}</h4>
        <ul class="space-y-3">
          <li>
            <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="text-sm transition-colors inline-flex items-center gap-1 hover:underline" style="color: hsl(var(--retro-cream) / 0.68)">
              LinkedIn <Icon name="arrow-up-right" size={12} />
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 flex flex-col items-center gap-3" style="border-top: 1px solid hsl(var(--retro-cream) / 0.18)">
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-sm" style="color: hsl(var(--retro-cream) / 0.68)">
        <span>© {year} haagsebrandmerk. {t.footer.rights}</span>
        <span class="hidden sm:inline">·</span>
        <span>KVK 42003114</span>
      </div>
      <p class="text-sm" style="color: hsl(var(--retro-cream) / 0.68)">{t.footer.madeBy}</p>
    </div>
  </div>
</footer>
