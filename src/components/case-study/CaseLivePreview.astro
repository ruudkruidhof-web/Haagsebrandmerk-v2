---
import Icon from "../Icon.astro";
import ScrollReveal from "../ScrollReveal.astro";
interface Props {
  liveUrl: string;
  liveDomain: string;
  accent?: string;
  accentInk?: string;
}
const { liveUrl, liveDomain, accent = "hsl(var(--primary))", accentInk = "#ffffff" } = Astro.props;
---
<section class="container mx-auto px-6 py-16 md:py-24">
  <ScrollReveal class="block">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
        <div>
          <div class="text-[11px] uppercase tracking-[0.3em] mb-2" style={`color: ${accent}`}>Live preview</div>
          <h2 class="font-display font-semibold leading-tight text-foreground" style="font-size: clamp(1.4rem, 2.2vw, 1.9rem)">Bekijk de site direct hierin</h2>
          <p class="mt-2 text-sm md:text-[15px] text-muted-foreground">Scroll binnen het kader om de live site te bekijken - zonder dat je deze pagina hoeft te verlaten.</p>
        </div>
        <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs uppercase tracking-[0.2em] transition-transform hover:scale-[1.03]" style={`background: ${accent}; color: ${accentInk}`}>
          Open live <Icon name="external-link" size={13} />
        </a>
      </div>
      <div class="relative overflow-hidden rounded-2xl border border-border bg-white" style="box-shadow: 0 30px 60px -25px rgba(0,0,0,0.25), 0 12px 24px -12px rgba(0,0,0,0.12)">
        <div class="flex items-center gap-3 px-4 py-2.5 border-b border-border bg-muted/40">
          <div class="flex gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full" style="background: #ff5f57"></span>
            <span class="w-2.5 h-2.5 rounded-full" style="background: #febc2e"></span>
            <span class="w-2.5 h-2.5 rounded-full" style="background: #28c840"></span>
          </div>
          <div class="flex-1 text-[11px] px-3 py-1 rounded-md truncate bg-background/70 text-muted-foreground">{liveDomain}</div>
        </div>
        <div class="relative w-full bg-white" style="height: min(78vh, 720px)">
          <iframe src={liveUrl} title={`${liveDomain} - live preview`} loading="lazy" class="absolute inset-0 w-full h-full" style="border: 0; background: #fff" sandbox="allow-scripts allow-same-origin allow-popups allow-forms" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </div>
  </ScrollReveal>
</section>
