---
import ScrollReveal from "../ScrollReveal.astro";
import { t } from "../../data/content.ts";
const stepPalette = [
  { bg: "hsl(var(--retro-butter))", shadow: "hsl(var(--retro-terracotta))", rot: -2.5, dark: false },
  { bg: "hsl(var(--retro-terracotta))", shadow: "hsl(var(--retro-ink))", rot: 1.5, dark: true },
  { bg: "hsl(var(--retro-cream))", shadow: "hsl(var(--retro-mustard))", rot: -1, dark: false },
  { bg: "hsl(var(--retro-mustard))", shadow: "hsl(var(--retro-rust))", rot: 2, dark: false },
];
---
<section class="relative py-20 md:py-28 overflow-hidden retro-grain" style="background: hsl(var(--retro-cream))">
  <div class="container mx-auto px-6 relative z-10">
    <ScrollReveal class="text-center max-w-2xl mx-auto mb-14 md:mb-20 block">
      <span class="inline-block px-4 py-1.5 rounded-full font-bold text-[11px] uppercase tracking-[0.18em] mb-5"
        style="background: hsl(var(--retro-terracotta)); color: hsl(var(--retro-cream)); border: 2px solid hsl(var(--retro-ink)); box-shadow: 4px 4px 0 0 hsl(var(--retro-ink)); transform: rotate(-2deg)">{t.howItWorks.tag}</span>
      <h2 class="retro-display mt-2 mb-4" style="color: hsl(var(--retro-ink)); font-size: clamp(2rem, 4.4vw, 3.4rem); line-height: 1.05">{t.howItWorks.title}</h2>
      <p class="text-base md:text-lg leading-relaxed" style="color: hsl(var(--retro-ink) / 0.75)">{t.howItWorks.subtitle}</p>
    </ScrollReveal>
    <div class="relative grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-x-14 md:gap-y-12 max-w-5xl mx-auto">
      {t.howItWorks.items.map((item, i) => {
        const p = stepPalette[i % 4];
        const fg = p.dark ? "hsl(var(--retro-cream))" : "hsl(var(--retro-ink))";
        return (
          <ScrollReveal delay={i * 100}>
            <div class="relative p-7 md:p-8" style={`background: ${p.bg}; border: 2px solid hsl(var(--retro-ink)); border-radius: 18px; box-shadow: 8px 8px 0 0 ${p.shadow}; transform: rotate(${p.rot}deg)`}>
              <div class="flex items-start justify-between mb-3">
                <span class="font-retro-display leading-none" style={`color: ${fg}; font-weight: 800; font-size: clamp(56px, 7vw, 88px); -webkit-text-stroke: ${p.dark ? "0" : "1px hsl(var(--retro-ink))"}; text-shadow: ${p.dark ? "4px 4px 0 hsl(var(--retro-rust))" : `4px 4px 0 ${p.shadow}`}`}>{item.step}</span>
              </div>
              <h3 class="retro-display text-2xl md:text-3xl mb-3" style={`color: ${fg}`}>{item.title}</h3>
              <p class="text-[15px] md:text-base leading-relaxed" style={`color: ${p.dark ? "hsl(var(--retro-cream) / 0.88)" : "hsl(var(--retro-ink) / 0.8)"}`}>{item.description}</p>
            </div>
          </ScrollReveal>
        );
      })}
    </div>
  </div>
</section>
