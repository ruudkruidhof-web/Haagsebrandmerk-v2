---
interface Props { class?: string; color?: string; }
const { class: className = "", color = "hsl(var(--retro-ink))" } = Astro.props;
---
<svg viewBox="0 0 1200 40" class={className} preserveAspectRatio="none" aria-hidden="true">
  <path d="M0 20 Q 75 0, 150 20 T 300 20 T 450 20 T 600 20 T 750 20 T 900 20 T 1050 20 T 1200 20" stroke={color} stroke-width="2.5" fill="none" />
</svg>
