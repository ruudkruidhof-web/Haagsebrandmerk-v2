---
import ScrollReveal from "../ScrollReveal.astro";
import FaqAccordion from "../FaqAccordion.astro";
import Icon from "../Icon.astro";
import SunBurst from "../decor/SunBurst.astro";
import Sparkle from "../decor/Sparkle.astro";
import { t, contentTestimonials, PHONE_NUMBER, PHONE_DISPLAY } from "../../data/content.ts";
import type { LandingContent } from "../../data/landings.ts";

interface Props { content: LandingContent; }
const { content } = Astro.props;
const site = "https://haagsebrandmerk.nl";
const url = `${site}/${content.slug}`;
const lastUpdated = "juni 2026";

const logos = [
  "/images/logos/reuring.png", "/images/logos/angela-ceremonies.png", "/images/logos/de-verse-gier.png",
  "/images/logos/once-upon-a-room.png", "/images/logos/den-hollander.png", "/images/logos/maisonette-1897.png",
];

// ── JSON-LD (SEO + GEO) ──
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: content.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: content.serviceName,
  name: content.serviceName,
  description: content.serviceDescription,
  url,
  areaServed: content.areaServed.map((a) => ({ "@type": "Place", name: a })),
  provider: {
    "@type": "LocalBusiness",
    "@id": `${site}/#business`,
    name: "Haagse Brandmerk",
    image: `${site}/images/ruud-kruidhof.jpeg`,
    url: site,
    telephone: PHONE_NUMBER,
    email: "ruud@haagsebrandmerk.nl",
    priceRange: "€995 - €4.503",
    address: { "@type": "PostalAddress", addressLocality: "Den Haag", addressRegion: "Zuid-Holland", addressCountry: "NL" },
    founder: { "@type": "Person", name: "Ruud Kruidhof" },
    areaServed: content.areaServed,
  },
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site },
    { "@type": "ListItem", position: 2, name: content.h1, item: url },
  ],
};
const processIcons = ["coffee", "sparkles", "rocket", "shield"];
---
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

<!-- breadcrumb (zichtbaar, voor SEO + gebruiker) -->
<nav aria-label="Kruimelpad" class="pt-24 md:pt-28 bg-[hsl(var(--retro-cream))]">
  <div class="container mx-auto px-6 pt-4">
    <ol class="flex items-center gap-2 text-xs text-muted-foreground">
      <li><a href="/" class="hover:underline">Home</a></li>
      <li aria-hidden="true">/</li>
      <li class="text-foreground font-medium">{content.h1}</li>
    </ol>
  </div>
</nav>

<!-- ═══ HERO ═══ -->
<section class="relative pt-8 pb-20 overflow-hidden retro-grain" style="background: hsl(var(--retro-cream))">
  <div class="absolute -left-24 top-10 w-72 h-72 retro-blob-radius retro-blob-idle-1 pointer-events-none" style="background: hsl(var(--retro-butter))"></div>
  <Sparkle class="absolute top-20 right-[14%] w-6 h-6 retro-blob-idle-2 pointer-events-none" color="hsl(var(--retro-mustard))" />
  <div class="container mx-auto px-6 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7">
        <span class="retro-sticker mb-6">{content.eyebrow}</span>
        <h1 class="retro-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[0.98] mb-6">{content.h1}</h1>
        <p class="text-lg md:text-xl leading-relaxed max-w-xl mb-8" style="color: hsl(var(--retro-ink) / 0.8)">{content.heroSub}</p>
        <div class="flex flex-wrap gap-4 mb-8">
          <button data-contact-open class="retro-pill-btn">
            <span class="relative z-10 inline-flex items-center gap-2">Plan een gratis kennismaking <Icon name="arrow-right" size={16} /></span>
          </button>
          <a href="/prijzen" class="retro-pill-btn-outline">
            <span class="relative z-10 inline-flex items-center gap-2">Bekijk de prijzen <Icon name="arrow-up-right" size={16} /></span>
          </a>
        </div>
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          {content.heroBullets.map((b) => (
            <li class="inline-flex items-center gap-1.5 text-sm font-medium" style="color: hsl(var(--retro-ink) / 0.75)">
              <Icon name="check" size={16} class="shrink-0" /> {b}
            </li>
          ))}
        </ul>
      </div>
      <ScrollReveal delay={120} class="lg:col-span-5 block">
        <div class="relative w-full max-w-[400px] mx-auto lg:ml-auto" style="transform: rotate(-3deg)">
          <SunBurst class="absolute -inset-10 w-[125%] h-[125%] retro-spin pointer-events-none opacity-70" color="hsl(var(--retro-mustard) / 0.8)" />
          <div class="absolute -inset-3 retro-blob-radius" style="background: hsl(var(--retro-mustard)); z-index: 0"></div>
          <img src="/images/ruud-hero.jpeg" alt={`Ruud Kruidhof — ${content.keyword}`} loading="eager"
            class="relative w-full retro-blob-radius object-cover aspect-[4/5]"
            style="border: 3px solid hsl(var(--retro-ink)); box-shadow: 6px 6px 0 hsl(var(--retro-terracotta))" />
          <div class="absolute -bottom-3 -left-3 z-10 retro-speech-bubble whitespace-nowrap" style="transform: rotate(-4deg)">koffie regel ik ☕</div>
        </div>
      </ScrollReveal>
    </div>
  </div>
</section>

<!-- ═══ DIRECT ANSWER (GEO) + E-E-A-T ═══ -->
<section class="py-12 md:py-16" style="background: hsl(var(--retro-butter) / 0.4)">
  <div class="container mx-auto px-6">
    <div class="max-w-3xl mx-auto retro-card p-7 md:p-9">
      <div class="flex items-center gap-3 mb-4">
        <img src="/images/ruud-avatar.png" alt="Ruud Kruidhof" loading="lazy" class="w-10 h-10 rounded-full object-cover" style="border: 1.5px solid hsl(var(--retro-ink))" />
        <div class="text-sm">
          <span class="font-semibold" style="color: hsl(var(--retro-ink))">Ruud Kruidhof</span>
          <span style="color: hsl(var(--retro-ink) / 0.6)"> · Webdesigner, Den Haag · bijgewerkt {lastUpdated}</span>
        </div>
      </div>
      <p class="text-lg leading-relaxed" style="color: hsl(var(--retro-ink) / 0.9)">{content.directAnswer}</p>
    </div>
  </div>
</section>

<!-- ═══ SOCIAL PROOF ═══ -->
<section class="py-10 border-y" style="background: hsl(var(--retro-cream)); border-color: hsl(var(--retro-ink) / 0.12)">
  <div class="container mx-auto px-6">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-3">
        <div class="flex gap-0.5">{Array.from({ length: 5 }).map(() => (<Icon name="star" size={18} class="text-retro-mustard" />))}</div>
        <span class="text-sm font-medium" style="color: hsl(var(--retro-ink) / 0.8)">Beoordeeld door 25+ ondernemers</span>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 opacity-80">
        {logos.map((src) => (<img src={src} alt="Klantlogo" loading="lazy" class="max-h-9 w-auto object-contain" />))}
      </div>
    </div>
  </div>
</section>

<!-- ═══ BENEFITS ═══ -->
<section class="py-20 md:py-28 retro-grain" style="background: hsl(var(--retro-cream))">
  <div class="container mx-auto px-6">
    <ScrollReveal class="max-w-3xl mb-14 block">
      <h2 class="retro-display text-3xl md:text-5xl mb-4">{content.benefitsTitle}</h2>
      <p class="text-lg" style="color: hsl(var(--retro-ink) / 0.72)">{content.benefitsIntro}</p>
    </ScrollReveal>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {content.benefits.map((b, i) => {
        const shadows = ["retro-card-shadow-terracotta", "retro-card-shadow-mustard", "retro-card-shadow-olive", "retro-card-shadow-rust"];
        const badges = ["hsl(var(--retro-terracotta))", "hsl(var(--retro-mustard))", "hsl(var(--retro-olive))", "hsl(var(--retro-rust))"];
        return (
          <ScrollReveal delay={i * 80}>
            <div class:list={["retro-card", shadows[i % 4], "p-6 h-full flex flex-col"]}>
              <div class="w-14 h-14 rounded-2xl flex items-center justify-center mb-4" style={`background: ${badges[i % 4]}; color: hsl(var(--retro-cream)); border: 2px solid hsl(var(--retro-ink)); box-shadow: 3px 3px 0 hsl(var(--retro-ink))`}>
                <Icon name={b.icon} size={24} strokeWidth={2.25} />
              </div>
              <h3 class="font-display font-bold text-lg mb-2" style="color: hsl(var(--retro-ink))">{b.title}</h3>
              <p class="text-sm leading-relaxed flex-1" style="color: hsl(var(--retro-ink) / 0.72)">{b.body}</p>
            </div>
          </ScrollReveal>
        );
      })}
    </div>
  </div>
</section>

<!-- ═══ DEEP / LOCAL / COST ═══ -->
<section class="py-20 md:py-28 retro-grain" style="background: hsl(var(--retro-butter) / 0.42)">
  <div class="container mx-auto px-6">
    <ScrollReveal class="max-w-3xl mb-12 block">
      <h2 class="retro-display text-3xl md:text-5xl mb-4">{content.deepTitle}</h2>
      <p class="text-lg" style="color: hsl(var(--retro-ink) / 0.72)">{content.deepIntro}</p>
    </ScrollReveal>

    {content.costTable ? (
      <div class="max-w-4xl">
        <div class="overflow-hidden rounded-2xl" style="border: 2.5px solid hsl(var(--retro-ink)); box-shadow: 8px 8px 0 hsl(var(--retro-mustard))">
          <table class="w-full text-sm bg-[hsl(var(--retro-cream))]">
            <thead>
              <tr style="border-bottom: 2px solid hsl(var(--retro-ink)); background: hsl(var(--retro-butter) / 0.5)">
                <th class="text-left py-4 px-5 font-bold">Pakket</th>
                <th class="text-left py-4 px-5 font-bold">Prijs</th>
                <th class="text-left py-4 px-5 font-bold hidden sm:table-cell">Beste voor</th>
              </tr>
            </thead>
            <tbody>
              {content.costTable.map((row, i) => (
                <tr style={`border-bottom: 1.5px solid hsl(var(--retro-ink) / 0.15); ${i % 2 ? "background: hsl(var(--retro-butter) / 0.15)" : ""}`}>
                  <td class="py-4 px-5 font-semibold" style="color: hsl(var(--retro-ink))">{row.name}</td>
                  <td class="py-4 px-5"><span class="font-display font-black text-lg">{row.price}</span> <span class="text-xs" style="color: hsl(var(--retro-ink) / 0.6)">{row.note}</span></td>
                  <td class="py-4 px-5 hidden sm:table-cell" style="color: hsl(var(--retro-ink) / 0.75)">{row.best}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-8">
          {content.deepItems.map((item) => (
            <div class="retro-soft-card p-5"><h3 class="font-display font-bold mb-1.5" style="color: hsl(var(--retro-ink))">{item.title}</h3><p class="text-sm" style="color: hsl(var(--retro-ink) / 0.72)">{item.body}</p></div>
          ))}
        </div>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {content.deepItems.map((item, i) => (
          <ScrollReveal delay={i * 80}>
            <div class="retro-card p-6 h-full">
              <h3 class="font-display font-bold text-lg mb-2" style="color: hsl(var(--retro-ink))">{item.title}</h3>
              <p class="text-sm leading-relaxed" style="color: hsl(var(--retro-ink) / 0.72)">{item.body}</p>
            </div>
          </ScrollReveal>
        ))}
      </div>
    )}
  </div>
</section>

<!-- ═══ PROCES ═══ -->
<section class="py-20 md:py-28 retro-grain" style="background: hsl(var(--retro-cream))">
  <div class="container mx-auto px-6">
    <ScrollReveal class="text-center max-w-2xl mx-auto mb-14 block">
      <span class="retro-sticker mb-5">{t.howItWorks.tag}</span>
      <h2 class="retro-display text-3xl md:text-5xl">{t.howItWorks.title}</h2>
    </ScrollReveal>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
      {t.howItWorks.items.map((item, i) => (
        <ScrollReveal delay={i * 80}>
          <div class="retro-card p-6 h-full flex flex-col" style={`background: ${i === 1 ? "hsl(var(--retro-terracotta))" : "hsl(var(--retro-cream))"}`}>
            <div class="flex items-start justify-between mb-4">
              <span class="font-black text-5xl leading-none italic" style={`color: ${i === 1 ? "hsl(var(--retro-cream))" : "hsl(var(--retro-rust))"}; font-family: 'Fraunces', serif`}>{item.step}</span>
              <div class="w-10 h-10 rounded-full flex items-center justify-center" style={`background: ${i === 1 ? "hsl(var(--retro-cream))" : "hsl(var(--retro-ink))"}; color: ${i === 1 ? "hsl(var(--retro-ink))" : "hsl(var(--retro-cream))"}`}>
                <Icon name={processIcons[i]} size={16} />
              </div>
            </div>
            <h3 class="font-display font-bold text-lg mb-2" style={`color: ${i === 1 ? "hsl(var(--retro-cream))" : "hsl(var(--retro-ink))"}`}>{item.title}</h3>
            <p class="text-sm leading-relaxed flex-1" style={`color: ${i === 1 ? "hsl(var(--retro-cream) / 0.85)" : "hsl(var(--retro-ink) / 0.7)"}`}>{item.description}</p>
          </div>
        </ScrollReveal>
      ))}
    </div>
  </div>
</section>

<!-- ═══ PRIJZEN TEASER ═══ -->
<section class="py-20 md:py-28 retro-grain" style="background: hsl(var(--retro-butter) / 0.42)">
  <div class="container mx-auto px-6">
    <ScrollReveal class="text-center max-w-2xl mx-auto mb-14 block">
      <span class="retro-sticker mb-5">{t.packagesPreview.tag}</span>
      <h2 class="retro-display text-3xl md:text-5xl">{t.packagesPreview.title}</h2>
    </ScrollReveal>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto items-center">
      {t.packagesPreview.packages.map((pkg, i) => {
        const isFeatured = i === 1;
        const shadows = ["retro-card-shadow-mustard", "retro-card-shadow-rust", "retro-card-shadow-terracotta"];
        return (
          <div class:list={["retro-card", shadows[i], "p-8 h-full flex flex-col relative", isFeatured ? "md:scale-105 z-10" : ""]} style={isFeatured ? "background: hsl(var(--retro-mustard)); border-width: 2.5px" : ""}>
            {isFeatured && (<span class="absolute -top-4 left-1/2 -translate-x-1/2 px-4 py-1 text-[11px] font-extrabold uppercase tracking-wider rounded-full whitespace-nowrap" style="background: hsl(var(--retro-rust)); color: hsl(var(--retro-cream)); border: 2px solid hsl(var(--retro-ink)); box-shadow: 3px 3px 0 hsl(var(--retro-ink))">★ {t.packagesPreview.mostChosen} ★</span>)}
            <h3 class="font-display font-bold text-xl" style="color: hsl(var(--retro-ink))">{pkg.name}</h3>
            <div class="flex items-baseline gap-2 mt-2 mb-3">
              <p class="font-display text-4xl font-black" style="color: hsl(var(--retro-ink))">{pkg.price}</p>
              <span class="text-xs font-medium" style="color: hsl(var(--retro-ink) / 0.6)">excl. btw</span>
            </div>
            <p class="text-sm leading-relaxed flex-1" style="color: hsl(var(--retro-ink) / 0.75)">{pkg.description}</p>
            <a href="/prijzen" class="fill-hover mt-6 inline-flex h-11 items-center justify-center rounded-full font-semibold text-sm px-6" style={isFeatured ? "background: hsl(var(--retro-ink)); color: hsl(var(--retro-cream)); border: 1.5px solid hsl(var(--retro-ink)); --fill-color: hsl(var(--retro-rust))" : "border: 1.5px solid hsl(var(--retro-ink)); color: hsl(var(--retro-ink)); --fill-color: hsl(var(--retro-mustard))"}>
              <span class="relative z-10">Bekijk dit pakket</span>
            </a>
          </div>
        );
      })}
    </div>
  </div>
</section>

<!-- ═══ TESTIMONIALS ═══ -->
<section class="py-20 md:py-28 retro-grain" style="background: hsl(var(--retro-cream))">
  <div class="container mx-auto px-6">
    <ScrollReveal class="text-center max-w-2xl mx-auto mb-12 block">
      <span class="retro-sticker mb-5">Wat klanten zeggen</span>
      <h2 class="retro-display text-3xl md:text-5xl">{t.testimonials.title}</h2>
    </ScrollReveal>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
      {contentTestimonials.map((tm, i) => {
        const shadows = ["retro-card-shadow-mustard", "retro-card-shadow-rust", "retro-card-shadow-terracotta"];
        return (
          <ScrollReveal delay={i * 80}>
            <div class:list={["retro-card", shadows[i], "p-7 h-full flex flex-col"]} style="background: hsl(var(--retro-cream))">
              <div class="flex gap-0.5 mb-3">{Array.from({ length: 5 }).map(() => (<Icon name="star" size={14} class="text-retro-mustard" />))}</div>
              <p class="leading-relaxed text-sm mb-5 flex-1" style="color: hsl(var(--retro-ink) / 0.85)">{tm.quote}</p>
              <div class="flex items-center gap-3 pt-4 border-t" style="border-color: hsl(var(--retro-ink) / 0.15)">
                <img src={tm.avatar} alt={tm.name} loading="lazy" class="w-10 h-10 rounded-full object-cover" style="border: 2px solid hsl(var(--retro-ink))" />
                <div><p class="font-bold text-sm" style="color: hsl(var(--retro-ink))">{tm.name}</p><p class="text-xs" style="color: hsl(var(--retro-ink) / 0.6)">{tm.role}</p></div>
              </div>
            </div>
          </ScrollReveal>
        );
      })}
    </div>
  </div>
</section>

<!-- ═══ FAQ (schema) ═══ -->
<section class="py-20 md:py-28 retro-grain" style="background: hsl(var(--retro-butter) / 0.42)">
  <div class="container mx-auto px-6">
    <div class="max-w-3xl mx-auto">
      <ScrollReveal class="block"><h2 class="retro-display text-3xl md:text-5xl mb-10 text-center">{content.faqTitle}</h2></ScrollReveal>
      <FaqAccordion faqs={content.faqs} />
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        {content.related.map((r) => (<a href={r.href} class="text-sm font-semibold hover:underline inline-flex items-center gap-1" style="color: hsl(var(--retro-rust))">{r.label} <Icon name="arrow-right" size={14} /></a>))}
      </div>
    </div>
  </div>
</section>

<!-- ═══ FINAL CTA ═══ -->
<section data-section-dark="true" class="py-24 md:py-32 relative overflow-hidden" style="background: hsl(var(--retro-ink)); color: hsl(var(--retro-cream))">
  <SunBurst class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] opacity-15 retro-spin pointer-events-none" color="hsl(var(--retro-mustard))" />
  <div class="container mx-auto px-6 text-center relative z-10">
    <ScrollReveal class="max-w-2xl mx-auto block">
      <h2 class="retro-display text-3xl md:text-5xl mb-5">Klaar voor een website die werkt?</h2>
      <p class="text-lg mb-10" style="color: hsl(var(--retro-cream) / 0.7)">Plan een gratis, vrijblijvende kennismaking. Een half uurtje, en meestal heb je er meteen iets aan.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <button data-contact-open class="fill-hover inline-flex items-center gap-2 px-8 py-4 rounded-full font-semibold" style="background: hsl(var(--retro-cream)); color: hsl(var(--retro-ink)); box-shadow: 4px 4px 0 hsl(var(--retro-mustard)); --fill-color: hsl(var(--retro-mustard))">
          <span class="relative z-10 inline-flex items-center gap-2">Plan gratis kennismaking <Icon name="arrow-up-right" size={16} /></span>
        </button>
        <a href={`tel:${PHONE_NUMBER}`} class="inline-flex items-center gap-1.5 text-sm" style="color: hsl(var(--retro-cream) / 0.7)"><Icon name="phone" size={14} /> Of bel direct: {PHONE_DISPLAY}</a>
      </div>
    </ScrollReveal>
  </div>
</section>
